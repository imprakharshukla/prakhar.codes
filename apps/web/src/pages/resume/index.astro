---
// Resume page: timeline rail, recent roles open, older roles collapsed (native <details>).
import Layout from "../../layouts/layout.astro";
import ResumeButton from "../../components/ResumeButton";
import FilePdfIcon from "../../components/icons/FilePdfIcon";
import TechBadge from "../../components/TechBadge";
import { roles, education, skillGroups } from "../../lib/resume";

const OPEN_COUNT = 2; // first N roles expanded by default
const work = roles.filter((r) => r.type !== "Personal Project");
const founder = roles.filter((r) => r.type === "Personal Project");
---

<Layout
  title="Resume - Prakhar Shukla"
  description="Complete professional background: AI engineer at Sherpa building production agent systems, previously Founding Engineer at Yobr (Norway). Serial founder with 2M+ downloads and $140K+ revenue."
>
  <div class="grid gap-2 md:max-w-2xl mt-6 animate-in fade-in duration-200">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="grid gap-2">
        <h1 class="h2-heading">Resume</h1>
        <p class="description leading-relaxed max-w-lg">
          Software engineer and serial founder. Building
          <span class="text-foreground font-medium">production AI agent systems</span>
          at Sherpa; previously Founding Engineer at Yobr. Products with
          <span class="text-foreground font-medium">2M+ downloads</span> and
          <span class="text-foreground font-medium">$140K+ revenue</span>.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 mt-3 flex-wrap">
      <ResumeButton title={"Download PDF"} client:load>
        <FilePdfIcon client:load />
      </ResumeButton>
      <span class="xs-description">Latest build, compiled from LaTeX on every push.</span>
    </div>

    <hr class="dark:border-border/50 border-border mt-4 mb-2" />

    <!-- Work -->
    <section class="grid gap-3">
      <div class="flex items-baseline justify-between">
        <h2 class="h3-heading">Work</h2>
        <span class="xs-description">{work.length} roles</span>
      </div>
      <ol class="list-none mt-1">
        {
          work.map((role, i) => {
            const last = i === work.length - 1;
            return (
            <li class="grid grid-cols-[20px_minmax(0,1fr)] gap-x-3">
              {/* rail: the dot sits on top, its own line segment runs to the next row, so the line never passes under a dot */}
              <div class="flex flex-col items-center pt-[18px]" aria-hidden="true">
                <span
                  class:list={[
                    "relative z-10 shrink-0 rounded-full",
                    role.current
                      ? "h-3 w-3 bg-primary shadow-[0_0_0_4px_hsl(var(--primary)/0.18)]"
                      : "h-2.5 w-2.5 border-2 border-muted-foreground/50 bg-background",
                  ]}
                />
                {!last && <span class="mt-1.5 w-px flex-1 bg-border dark:bg-border/70" />}
              </div>
              <details class="group min-w-0" open={i < OPEN_COUNT}>
                <summary class="list-none cursor-pointer select-none rounded-md px-3 py-2.5 hover:bg-primary/5 transition-colors [&::-webkit-details-marker]:hidden">
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex flex-col gap-1 min-w-0">
                      <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="h5-heading break-words">{role.name}</h3>
                        <span class="text-primary bg-primary/20 px-1.5 py-1 rounded font-medium text-xs whitespace-nowrap">{role.type}</span>
                      </div>
                      <p class="s-description !text-foreground/90 break-words">
                        {role.title}
                        {role.titleNote && <span class="text-muted-foreground"> ({role.titleNote})</span>}
                      </p>
                      <p class="xs-description flex items-center gap-x-1.5 gap-y-0.5 flex-wrap">
                        <span class={role.current ? "text-foreground/80" : ""}>{role.date}</span>
                        {role.location && (
                          <>
                            <span aria-hidden="true">·</span>
                            <span>{role.location}</span>
                          </>
                        )}
                        <span aria-hidden="true">·</span>
                        <span class="group-open:hidden">{role.bullets.length} highlights</span>
                        <span class="hidden group-open:inline">Hide</span>
                      </p>
                    </div>
                    <svg
                      class="mt-1.5 h-4 w-4 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    ><path d="m6 9 6 6 6-6" /></svg>
                  </div>
                </summary>
                <div class:list={["px-3", last ? "pb-2" : "pb-7"]}>
                  {role.tagline && <p class="xs-description mb-2">{role.tagline}</p>}
                  <ul class="mt-1 grid gap-2.5">
                    {role.bullets.map((b) => (
                      <li class="flex gap-2.5 text-sm leading-relaxed min-w-0">
                        <span class="mt-[9px] h-1 w-1 flex-shrink-0 rounded-full bg-muted-foreground/60" />
                        <span class="flex-1 min-w-0 break-words">
                          {b.label && <span class="font-semibold text-foreground">{b.label}. </span>}
                          <span class="text-muted-foreground">{b.text}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
                {!last && <div class="h-3 group-open:hidden" />}
              </details>
            </li>
            );
          })
        }
      </ol>
    </section>

    <hr class="dark:border-border/50 border-border mt-6 mb-2" />

    <!-- Founder work -->
    <section class="grid gap-3">
      <div class="flex items-baseline justify-between">
        <h2 class="h3-heading">Founder</h2>
        <span class="xs-description">Both still running</span>
      </div>
      <ul class="grid gap-6 mt-1">
        {
          founder.map((role) => (
            <li>
              <details class="group" open>
                <summary class="list-none cursor-pointer select-none rounded-md px-2 py-2 hover:bg-primary/5 transition-colors [&::-webkit-details-marker]:hidden">
                  <div class="flex gap-4 items-start">
                    {role.thumb && (
                      <img
                        src={role.thumb}
                        alt=""
                        class="hidden sm:block w-36 aspect-video object-cover rounded-sm shadow-sm flex-shrink-0 border border-transparent group-hover:border-primary transition-colors"
                      />
                    )}
                    <div class="flex flex-col gap-1 min-w-0 flex-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="h5-heading">{role.name}</h3>
                        <span class="text-primary bg-primary/20 px-1.5 py-1 rounded font-medium text-xs">{role.title}</span>
                      </div>
                      {role.tagline && <p class="s-description line-clamp-2">{role.tagline}</p>}
                      <p class="xs-description flex items-center gap-1.5 flex-wrap">
                        <span>{role.date}</span>
                        {role.url && (
                          <>
                            <span aria-hidden="true">·</span>
                            <a href={role.url} target="_blank" rel="noopener noreferrer" class="underline decoration-primary/40 underline-offset-2 hover:decoration-primary hover:text-foreground transition-all">
                              {role.url.replace("https://", "")}
                            </a>
                          </>
                        )}
                        <span aria-hidden="true">·</span>
                        <span class="group-open:hidden">{role.bullets.length} highlights</span>
                        <span class="hidden group-open:inline">Hide</span>
                      </p>
                    </div>
                    <svg
                      class="mt-2 h-4 w-4 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    ><path d="m6 9 6 6 6-6" /></svg>
                  </div>
                </summary>
                <ul class="mt-3 grid gap-2.5 px-2 sm:pl-[10.5rem]">
                  {role.bullets.map((b) => (
                    <li class="flex gap-2.5 text-sm leading-relaxed">
                      <span class="mt-[9px] h-1 w-1 flex-shrink-0 rounded-full bg-muted-foreground/60" />
                      <span class="flex-1 min-w-0 break-words">
                        {b.label && <span class="font-semibold text-foreground">{b.label}. </span>}
                        <span class="text-muted-foreground">{b.text}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
      </ul>
    </section>

    <hr class="dark:border-border/50 border-border mt-8 mb-2" />

    <!-- Education + Skills side by side on md -->
    <div class="grid gap-8 md:grid-cols-[1fr_1.4fr]">
      <section class="grid gap-3 content-start">
        <h2 class="h3-heading">Education</h2>
        <ul class="grid gap-4 mt-1">
          {
            education.map((edu) => (
              <li class="grid gap-0.5">
                <p class="text-sm font-medium text-foreground leading-snug">{edu.institution}</p>
                <p class="xs-description">{edu.details[0]}</p>
                <p class="xs-description">{edu.date} <span aria-hidden="true">·</span> {edu.location}</p>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="grid gap-3 content-start">
        <h2 class="h3-heading">Skills</h2>
        <div class="grid gap-3 mt-1">
          {
            skillGroups.map((g) => (
              <div class="grid gap-1.5">
                <p class="xs-description font-medium uppercase tracking-wide">{g.name}</p>
                <div class="flex flex-wrap gap-1.5">
                  {g.items.map((s) => <TechBadge tech={s} size="sm" />)}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
