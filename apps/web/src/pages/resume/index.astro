---
import { cn } from "@prakhar/ui";
import Layout from "../../layouts/layout.astro";
import SkillAccordion from "../../components/SkillAccordion";
import IconButton from "../../components/IconButton.astro";
import ResumeButton from "../../components/ResumeButton";
import { experience } from "../../data/experience";
---

<Layout
  title="Resume - Prakhar Shukla"
  description="Complete professional background: AI engineer at Sherpa building production agent systems, previously Founding Engineer at Yobr (Norway). Serial founder with 2M+ downloads and $140K+ revenue."
>
    <div class="grid gap-1 md:max-w-2xl mt-6">
      <div class="flex items-center gap-2">
        <h1 class="h2-heading">Resume</h1>
        <div class="relative group">
          <button type="button" class="appearance-none bg-transparent border-none p-0 cursor-help">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" class="text-muted-foreground"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"/><path d="M144,176a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176Zm88-48A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128ZM124,96a12,12,0,1,0-12-12A12,12,0,0,0,124,96Z"/></svg>
          </button>
          <div class="absolute bottom-full left-0 mb-2 px-3 py-2 rounded-md border border-border bg-popover text-popover-foreground shadow-md text-xs leading-relaxed w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 z-[9999]">
            LaTeX resume compiled via GitHub Actions, uploaded to Cloudflare R2. The download button fetches the latest version dynamically - no redeploy needed.
          </div>
        </div>
      </div>
      <div class="grid gap-3">
        <p class="description mb-4">
          I'm a software engineer with a passion for building products that
          people love. I have experience working with a variety of technologies
          and languages, including JavaScript, TypeScript, React, Node.js. I
          care about shipping useful software, learning quickly, and growing
          through ambitious technical problems.
        </p>
      </div>
      <ResumeButton title={"Resume"} client:load>
        <svg
          class="text-current h-4 w-4"
          role="img"
          fill="currentColor"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-file-text"
          ><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
          ></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"
          ></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg
        >
      </ResumeButton>
      <div class="grid gap-3">
        <h2
          class="border-l-2 border-primary pl-3 text-foreground font-semibold text-3xl my-5"
        >
          Work Experience
        </h2>
        <div class="px-5">
          <ul class="relative border-l border-border/40 list-none">
            {
              experience.map((work, index) => (
                <li class="mb-10 ml-4">
                  <div style="">
                    <div class="absolute w-3 h-3 bg-primary/70 rounded-full mt-1.5 -left-1.5" />
                    <time class="mb-1 font-normal leading-none text-muted-foreground">
                      {work.date}
                    </time>
                    <div class="grid gap-1">
                      <h3 class="text-lg font-semibold text-foreground flex items-center gap-2 flex-wrap">
                        {work.company}
                        <span
                          class={cn(
                            "inline-flex items-center rounded-md px-1.5 py-0.5 font-medium text-xs/5 forced-colors:outline w-fit",
                            work.type === "Full-time" &&
                              "bg-blue-500/15 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400",
                            work.type === "Contract" &&
                              "bg-emerald-500/15 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400",
                            work.type === "Internship" &&
                              "bg-purple-500/15 text-purple-700 dark:bg-purple-500/10 dark:text-purple-400",
                            work.type === "Personal Project" &&
                              "bg-orange-500/15 text-orange-700 dark:bg-orange-500/10 dark:text-orange-400"
                          )}
                        >
                          {work.type}
                        </span>
                      </h3>
                      <p class="font-normal text-muted-foreground">
                        {work.designation}
                      </p>
                      <ul class="mt-3 space-y-2">
                        {work.details.map((detail, idx) => {
                          const colonIndex = detail.indexOf(":");
                          const hasLabel = colonIndex !== -1;
                          const label = hasLabel
                            ? detail.substring(0, colonIndex)
                            : null;
                          const text = hasLabel
                            ? detail.substring(colonIndex + 1).trim()
                            : detail;

                          return (
                            <li class="flex gap-2 text-sm leading-relaxed">
                              <span class="text-muted-foreground mt-1.5">•</span>
                              <span class="flex-1">
                                {hasLabel && (
                                  <span class="font-semibold text-foreground">
                                    {label}:
                                  </span>
                                )}{" "}
                                <span class="text-muted-foreground">{text}</span>
                              </span>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <!-- Education -->
      <div class="grid gap-3">
        <h2
          class="border-l-2 border-primary pl-3 text-foreground font-semibold text-3xl my-5"
        >
          Education
        </h2>
        <div class="px-5">
          <ul class="relative border-l border-border/40 list-none">
            {
              [
                {
                  date: "2021 - 2025",
                  institution:
                    "Dr. A.P.J. Abdul Kalam Technical University (AKTU)",
                  location: "Lucknow",
                  details: [
                    "B.Tech in Computer Science and Engineering (Artificial Intelligence)",
                    "Part of various Technical Clubs, core member of Loop, the Coding Club",
                  ],
                },
                {
                  date: "2019 - 2020",
                  institution: "Spring Dale College",
                  location: "Lucknow",
                  details: [
                    "President of the Computer Science and Mathematics Club",
                    "Senior Year in PCM + Computer Science",
                  ],
                },
              ].map((education, index) => (
                <li class="mb-10 ml-4">
                  <div style="">
                    <div class="absolute w-3 h-3 bg-primary/70 rounded-full mt-1.5 -left-1.5" />
                    <time class="mb-1  font-normal leading-none text-muted-foreground">
                      {education.date}
                    </time>
                    <div class="grid gap-1">
                      <h3 class="text-lg font-semibold text-foreground">
                        {education.institution}
                      </h3>
                      <p class="font-normal  text-muted-foreground">
                        {education.location}
                      </p>
                      {education.details.map((detail, idx) => (
                        <ul class="">
                          <li>
                            <p class=" font-normal text-muted-foreground">
                              - {detail}
                            </p>
                          </li>
                        </ul>
                      ))}
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <!-- Skills -->
        <div class="grid gap-3">
          <div class="grid gap-3 mt-5">
            <h2
              class="border-l-2 border-primary pl-3 text-foreground font-semibold text-3xl my-5"
            >
              Skills
            </h2>
            <SkillAccordion client:load />
          </div>
        </div>
      </div>
    </div>
  </Layout>
